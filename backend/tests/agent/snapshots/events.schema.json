    {
      "$ref": "#/$defs/RegionEvent"
    },
    {
      "$ref": "#/$defs/MessageStartedEvent"
    },
    {
      "$ref": "#/$defs/TokenEvent"
    },
    {
      "$ref": "#/$defs/MessageCompletedEvent"
    },
    {
      "$ref": "#/$defs/RewriteDeltaEvent"
    },
    {
      "$ref": "#/$defs/ToolCallEvent"
    },
    {
      "$ref": "#/$defs/ToolResultEvent"
    },
    {
      "$ref": "#/$defs/CompileEvent"
    },
    {
      "$ref": "#/$defs/DiagnosticsEvent"
    },
    {
      "$ref": "#/$defs/ProposalEvent"
    },
    {
      "$ref": "#/$defs/ResolvedEvent"
    },
    {
      "$ref": "#/$defs/UsageEvent"
