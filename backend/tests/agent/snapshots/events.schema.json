        "v": {
          "type": "integer",
          "const": 1
        },
        "seq": {
          "type": "integer",
          "minimum": 1
        },
        "turn_id": {
          "type": "string"
        },
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "type": {
          "type": "string",
          "const": "compile"
        },
        "stage": {
          "type": "string",
          "enum": [
            "baseline",
            "proposal"
          ]
        },
        "round": {
          "type": "integer"
        },
        "state": {
          "type": "string",
          "enum": [
            "started",
            "finished",
            "cached"
          ]
        },
        "ok": {
          "type": "boolean"
        },
        "errors": {
          "type": "integer"
        },
        "warnings": {
          "type": "integer"
        },
        "duration_ms": {
          "type": "integer"
