{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "run_terminal_command|Bash|bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${GROK_WORKSPACE_ROOT}/.venv/Scripts/python.exe\" \"${GROK_WORKSPACE_ROOT}/.grok/hooks/bin/post_test_mark.py\"",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${GROK_WORKSPACE_ROOT}/.venv/Scripts/python.exe\" \"${GROK_WORKSPACE_ROOT}/.grok/hooks/bin/stop_ship_gate.py\"",
            "timeout": 600
          }
        ]
      }
    ]
  }
}
