# --- Pluggable LLM (LangChain chat model factory; wired in later phases) ---
PRISM_LLM_PROVIDER=openai
PRISM_LLM_MODEL=gpt-4o
PRISM_LLM_API_KEY=
PRISM_LLM_BASE_URL=

# Supported providers (planned): openai | azure | ollama | anthropic | custom
# For OpenAI-compatible gateways, set PROVIDER=openai (or custom) and BASE_URL.

# --- Paths (relative to monorepo root unless absolute) ---
PRISM_PROJECTS_ROOT=data/projects
PRISM_PREVIEW_ROOT=data/previews
PRISM_SKILL_HOME=data/skill-home

# --- API server ---
HOST=127.0.0.1
PORT=8000

# --- Frontend (Next.js) ---
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
