# --- Pluggable LLM ---
# Default: Groq (reads GROQ_API_KEY from this file)
PRISM_LLM_PROVIDER=groq
PRISM_LLM_MODEL=llama-3.3-70b-versatile
PRISM_LLM_API_KEY=
PRISM_LLM_BASE_URL=

# Required for provider=groq (https://console.groq.com)
GROQ_API_KEY=

# Supported providers: groq | openai | azure | ollama | anthropic | custom
# Groq uses OpenAI-compatible API at https://api.groq.com/openai/v1
# Ollama default BASE_URL if empty: http://127.0.0.1:11434/v1
# Azure: PRISM_LLM_BASE_URL = https://{resource}.openai.azure.com/

# --- Paths (relative to monorepo root unless absolute) ---
PRISM_PROJECTS_ROOT=data/projects
PRISM_PREVIEW_ROOT=data/previews
PRISM_SKILL_HOME=data/skill-home

# --- API server ---
HOST=127.0.0.1
PORT=8000

# --- Frontend (Next.js) ---
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
