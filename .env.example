# --- Pluggable LLM (LangChain chat model factory; wired in later phases) ---
PRISM_LLM_PROVIDER=openai
PRISM_LLM_MODEL=gpt-4o
PRISM_LLM_API_KEY=
PRISM_LLM_BASE_URL=

# Supported providers: openai | azure | ollama | anthropic | custom
# Switch provider via PRISM_LLM_PROVIDER only — no source edits.
# OpenAI-compatible gateways: PROVIDER=openai|custom|ollama + BASE_URL.
# Ollama default BASE_URL if empty: http://127.0.0.1:11434/v1
# Azure: PRISM_LLM_BASE_URL = https://{resource}.openai.azure.com/
#        PRISM_LLM_MODEL = deployment name

# --- Paths (relative to monorepo root unless absolute) ---
PRISM_PROJECTS_ROOT=data/projects
PRISM_PREVIEW_ROOT=data/previews
PRISM_SKILL_HOME=data/skill-home

# --- API server ---
HOST=127.0.0.1
PORT=8000

# --- Frontend (Next.js) ---
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
